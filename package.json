{
  "name": "symbux-eslint-prettier-config",
  "version": "2.0.0",
  "scripts": {
    "pre:build": "rimraf ./dist",
    "build": "npm run pre:build && tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "lint": "eslint . --ext .ts --ignore-pattern 'node_modules/*' --ignore-pattern 'dist/*' --ignore-pattern 'scripts/*'",
    "format": "prettier --write .",
    "prepare": "ts-node .husky/install",
    "pre:publish": "npm publish --dry-run",
    "publish": "npm publish --access public"
  },
  "keywords": [
    "nestjs",
    "eslint",
    "symbux-eslint-prettier-config",
    "prettier"
  ],
  "author": "Dmitry Podkopaev",
  "license": "MIT",
  "type": "module",
  "description": "Configurator eslint and prettier for nestjs and react",
  "homepage": "https://github.com/ethicco/eslint-prettier-configurator",
  "repository": {
    "type": "github",
    "url": "https://github.com/ethicco/eslint-prettier-configurator"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-jest-extended": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.0.2",
    "globals": "^17.4.0",
    "jest": "^30.0.3",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.58.1"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^24.14.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "eslint": ">= 10",
    "prettier": ">= 3"
  },
  "lint-staged": {
    "**/*.ts": [
      "npm run format",
      "npm run lint"
    ]
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./eslint-nest": {
      "types": "./dist/types/eslint/eslintrc-nest.d.ts",
      "import": "./dist/eslint/eslintrc-nest.js",
      "default": "./dist/eslint/eslintrc-nest.js"
    },
    "./prettierrc-nest": {
      "types": "./dist/types/prettier/prettierrc-nest.d.ts",
      "import": "./dist/prettier/prettierrc-nest.js",
      "default": "./dist/prettier/prettierrc-nest.js"
    },
    "./eslint-react": {
      "types": "./dist/types/eslint/eslintrc-react.d.ts",
      "import": "./dist/eslint/eslintrc-react.js",
      "default": "./dist/eslint/eslintrc-react.js"
    },
    "./prettierrc-react": {
      "types": "./dist/types/prettier/prettierrc-react.d.ts",
      "import": "./dist/prettier/prettierrc-react.js",
      "default": "./dist/prettier/prettierrc-react.js"
    }
  }
}
