{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "declaration": true,
    "declarationDir": "./dist/types",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "removeComments": true,
    "skipLibCheck": true
  },
  "files": ["types/eslint-plugin-jest-extended.d.ts", "types/global.d.ts"],
  "include": ["src", "types"],
  "exclude": ["dist", "node_modules", "src/test"]
}
